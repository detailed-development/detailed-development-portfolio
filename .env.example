# Base URL of the WordPress headless CMS (the subdomain running DD Portfolio CMS).
# No trailing slash. Projects use GET /wp-json/dd/v1/projects; the contact popup
# submits to POST /wp-json/dd/v1/contact (requires DD Portfolio CMS 1.1.0+).
# If blank, projects use bundled fallback data and the form offers direct email.
#
# Copy this file to .env (or .env.local) and fill in your subdomain:
VITE_CMS_URL=https://admin.detailed-development.com
